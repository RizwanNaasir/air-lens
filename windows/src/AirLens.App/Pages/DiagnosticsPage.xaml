<Page
    x:Class="AirLens.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Live numbers from the receiver, updated twice a second. Copy them into a bug report together with the log."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copy" Click="OnCopyClick" />
                <Button Content="Open log folder" Click="OnOpenLogsClick" />
            </StackPanel>
            <Border Padding="16" CornerRadius="{StaticResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="StatsText" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
