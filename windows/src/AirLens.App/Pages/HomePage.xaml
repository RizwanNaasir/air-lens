<Page
    x:Class="AirLens.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" />
            <InfoBar x:Name="HeatBar" Severity="Warning" IsOpen="False" IsClosable="False" />

            <Grid x:Name="Columns" ColumnSpacing="24" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" MinWidth="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="LeftColumn" Spacing="12" VerticalAlignment="Top">
                    <Border x:Name="PreviewFrame" Height="360" CornerRadius="8" Background="Black"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <!-- The decoder's D3D11 device renders straight into this panel's swap chain. -->
                            <SwapChainPanel x:Name="Preview" />
                            <!-- Opaque, so the last picture of a lost stream never lingers behind it. -->
                            <Grid x:Name="PreviewPlaceholder" Background="Black">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="PreviewPlaceholderText" Text="The phone's picture appears here"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                                    <Button x:Name="ShowPreviewButton" Content="Show preview" HorizontalAlignment="Center"
                                            Visibility="Collapsed" Click="OnShowPreviewClick" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="HiddenBadge" Visibility="Collapsed" Margin="12" Padding="10,4" CornerRadius="4"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                                <TextBlock Text="Hidden from apps" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Frame rate" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="FpsValue" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Bitrate" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="BitrateValue" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="PC delay" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PcDelayValue" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Dropped" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DroppedValue" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock Text="Phone" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />

                    <tk:SettingsCard x:Name="UsbCard" Header="USB" Description="Looking for a phone on the cable">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE88E;" /></tk:SettingsCard.HeaderIcon>
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                    </tk:SettingsCard>

                    <!-- Phones found on Wi-Fi by discovery, one card each with Connect (built in code). -->
                    <StackPanel x:Name="FoundPhonesPanel" Spacing="{StaticResource SettingsCardSpacing}" />

                    <tk:SettingsCard x:Name="WifiCard" Header="Wi-Fi" Description="Looking for phones on this network. Or type the address the phone shows">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE701;" /></tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="HostBox" PlaceholderText="Phone's IP address" Width="150" KeyDown="OnHostKeyDown" AutomationProperties.Name="Phone IP address" />
                            <Button Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="OnConnectWifiClick" />
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="PhoneCard" Header="Phone" Visibility="Collapsed">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EA;" /></tk:SettingsCard.HeaderIcon>
                        <Button Content="Disconnect" Click="OnDisconnectClick" />
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="StoppedCard" Header="Disconnected" Description="AirLens is not looking for your phone" Visibility="Collapsed">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EA;" /></tk:SettingsCard.HeaderIcon>
                        <Button Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="OnConnectClick" />
                    </tk:SettingsCard>

                    <TextBlock Text="Camera" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <!-- Expands to the picture controls (mirror, rotate, zoom, framing, hide), added in code. -->
                    <tk:SettingsExpander x:Name="VcamExpander" Header="Virtual camera">
                        <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE714;" /></tk:SettingsExpander.HeaderIcon>
                        <ToggleSwitch x:Name="VcamToggle" Toggled="OnVcamToggled" AutomationProperties.Name="Virtual camera" />
                    </tk:SettingsExpander>

                    <tk:SettingsCard x:Name="LensCard" Header="Lens" Description="Available once a phone is connected"
                                     ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE722;" /></tk:SettingsCard.HeaderIcon>
                        <tk:Segmented x:Name="LensSegmented" SelectionChanged="OnLensChanged" AutomationProperties.Name="Lens" />
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="FocusCard" Header="Focus" Description="Available once a phone is connected"
                                     ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE890;" /></tk:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="AutoFocusToggle" OnContent="Autofocus" OffContent="Fixed focus"
                                          Toggled="OnAutoFocusToggled" AutomationProperties.Name="Autofocus" />
                            <Grid x:Name="FocusRow" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Far" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Slider x:Name="FocusSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01"
                                        ValueChanged="OnFocusSliderChanged" AutomationProperties.Name="Focus distance" />
                                <TextBlock Grid.Column="2" Text="Near" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="QualityCard" Header="Quality" Description="Available once a phone is connected">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9E9;" /></tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="QualityBox" MinWidth="200" SelectionChanged="OnQualityChanged" AutomationProperties.Name="Quality" />
                    </tk:SettingsCard>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
