<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- Windows App SDK 1.8 and Community Toolkit 8.2 need C#/WinRT 2.2 (WinRT.Runtime 2.2). -->
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <RootNamespace>AirLens.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained Windows App SDK: runs from a folder, no MSIX or runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AirLens.ico</ApplicationIcon>
    <AssemblyTitle>AirLens</AssemblyTitle>
    <!-- Only English .NET satellite assemblies; the UI is English. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirLens.Core\AirLens.Core.csproj" />
  </ItemGroup>

  <!-- Title bar and taskbar icon (AppWindow.SetIcon reads it from disk). -->
  <ItemGroup>
    <Content Include="Assets\AirLens.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    An FFmpeg 8.x LGPL shared build goes in .\ffmpeg next to the exe (not committed): BtbN's
    ffmpeg-n8.1-latest-win64-lgpl-shared-8.1, its bin\*.dll and LICENSE.txt. Never a GPL build: AirLens
    is distributed, and a GPL FFmpeg would put the whole app under the GPL. The decoder only calls
    libavcodec and libavutil, and libavcodec imports libswresample; the other libraries of a shared
    build (avformat, avfilter, avdevice, swscale; ~70 MB) are left out of the output. The licence and
    THIRD-PARTY-NOTICES.txt ship with them, as the LGPL requires.
  -->
  <ItemGroup>
    <None Include="ffmpeg\avcodec-*.dll;ffmpeg\avutil-*.dll;ffmpeg\swresample-*.dll;ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="ffmpeg\%(Filename)%(Extension)" Condition="Exists('ffmpeg')" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

</Project>
