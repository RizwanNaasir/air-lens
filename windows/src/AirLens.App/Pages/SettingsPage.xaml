<Page
    x:Class="AirLens.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <tk:SettingsCard Header="Video decoder" Description="Automatic uses the NVIDIA GPU when the PC has one. Changing it reconnects.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE950;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DecoderBox" MinWidth="220" SelectionChanged="OnDecoderChanged" AutomationProperties.Name="Video decoder">
                    <ComboBoxItem Content="Automatic" Tag="auto" />
                    <ComboBoxItem Content="Direct3D 11 (D3D11VA)" Tag="d3d11va" />
                    <ComboBoxItem Content="NVIDIA CUDA" Tag="cuda" />
                    <ComboBoxItem Content="Software" Tag="software" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="LogsCard" Header="Log files">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="Open folder" Click="OnOpenLogsClick" />
            </tk:SettingsCard>

            <TextBlock Text="Updates" Style="{StaticResource SectionHeaderTextBlockStyle}" />

            <!-- Status and actions; texts and visibility are set from UpdateService (code-behind). -->
            <tk:SettingsCard x:Name="UpdateCard" Header="AirLens">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                    <ProgressBar x:Name="UpdateProgress" Width="160" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                 Visibility="Collapsed" AutomationProperties.Name="Download progress" />
                    <HyperlinkButton x:Name="WhatsNewLink" Content="What's new" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="OnCancelUpdateClick" />
                    <Button x:Name="CheckButton" Content="Check for updates" Click="OnCheckUpdatesClick" />
                    <Button x:Name="InstallButton" Content="Update now" Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed" Click="OnInstallUpdateClick" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Check for updates automatically"
                             Description="About once a day, shortly after AirLens starts. Installing always asks you first.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutoCheckToggle" Toggled="OnAutoCheckToggled" AutomationProperties.Name="Check for updates automatically" />
            </tk:SettingsCard>

            <InfoBar x:Name="UpdateError" Severity="Error" IsClosable="True" IsOpen="False" Title="Update" />

            <TextBlock Text="About" Style="{StaticResource SectionHeaderTextBlockStyle}" />

            <tk:SettingsCard x:Name="AboutCard" Header="AirLens">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></tk:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="silow.net" NavigateUri="https://silow.net" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
